# ==============================================================================
# Cyber Fraud Correlator - Environment Configuration Template
# Copy this file to .env and configure values before starting services
# ==============================================================================

# Database connection URL (e.g. SQLite for local dev or PostgreSQL)
DATABASE_URL=sqlite:///./fraud_correlator.db

# API Service Configuration
API_PORT=8000
HOST=0.0.0.0

# Frontend Service Configuration
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000

# Local-File Encryption Key (32-byte hexadecimal key for data at rest)
# Generate a secure key using one of the following commands:
#   Option 1 (OpenSSL): openssl rand -hex 32
#   Option 2 (Python):  python3 -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=replace_with_a_secure_64_character_hex_string_32_bytes
